# MacroTrack Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Episodic Memory (mem0)
MEM0_API_KEY=
MEM0_USER_ID=default_user

# Supabase Database (Leave blank to use local SQLite database)
SUPABASE_URL=
SUPABASE_KEY=

# Knowledge Graph (Leave blank to use in-memory NetworkX graph engine)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Server Settings
PORT=8000
HOST=0.0.0.0
